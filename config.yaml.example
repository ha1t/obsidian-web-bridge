# Obsidian Web Bridge 設定ファイル
vault_path: /path/to/your/ObsidianVault
port: 18484
api_key: "change-me-to-a-secure-key"
bind: "0.0.0.0"

# リモートMCP（claude.ai カスタムコネクタ）。このセクションがあるときだけ MCP リスナーが起動する
# 使うときはコメントを外し、cf_access_team_domain と cf_access_aud を実際の値にする（README 参照）
# mcp:
#   bind: "127.0.0.1"
#   port: 18485
#   cf_access_team_domain: "<team>.cloudflareaccess.com"
#   cf_access_aud: "<Application Audience Tag>"
#   timezone: "Asia/Tokyo"          # DailyNote の「今日」の判定に使う
#   readonly_folders:               # 書き込み禁止フォルダ（Vault 直下のフォルダ名。/ を含む指定は起動エラー）
#     - DailyReports
#     - MorningBrief
#     - Calendar
#     - Garmin
#     - MonthlyReview
#     - Templates
#     - bases
